diff --git a/apps/cms/test/access.test.mjs b/apps/cms/test/access.test.mjs
index cc17535..ba6b028 100644
--- a/apps/cms/test/access.test.mjs
+++ b/apps/cms/test/access.test.mjs
@@ -43,5 +43,11 @@ const sourceHook=knowledge.hooks.beforeChange[1];
 const approvedSource={id:1,title:'Public source',approved:true,_status:'published',jurisdiction:'VN',body:'Reviewed source',reviewedBy:1,reviewedAt:'2026-11-03T00:00:00Z'};
 test('source withdrawal immediately removes publication',()=>{const d=sourceHook({req:req('reviewer'),data:{approved:false,_status:'published'},originalDoc:approvedSource});assert.equal(d._status,'draft');assert.equal(d.reviewedBy,null)});
 test('editing source invalidates approval and review attribution',()=>{const d=sourceHook({req:req('knowledge'),data:{body:'New text'},originalDoc:approvedSource});assert.equal(d.approved,false);assert.equal(d._status,'draft');assert.equal(d.reviewedAt,null)});
-test('knowledge author cannot approve own source',()=>assert.throws(()=>sourceHook({req:req('knowledge'),data:{approved:true},originalDoc:{...approvedSource,approved:false,_status:'draft'}}),/Reviewer required/));
+test('scoped knowledge author can self-approve own source',()=>assert.equal(sourceHook({req:req('knowledge'),data:{approved:true},originalDoc:{...approvedSource,approved:false,_status:'draft'}}).approved,true));
+test('support self-publishes an in-scope FAQ and records author',()=>{const d=sourceHook({req:req('support'),data:{title:'Question',body:'Answer',jurisdiction:'VN',_status:'published'}});assert.equal(d.approved,true);assert.equal(d.reviewedBy,1);assert.ok(d.reviewedAt)});
+test('support cannot create knowledge outside assigned country',()=>assert.equal(knowledge.access.create({req:req('support'),data:{jurisdiction:'DE'}}),false));
+test('knowledge read access is scoped to assigned country',()=>assert.deepEqual(knowledge.access.read({req:req('knowledge')}),{jurisdiction:{in:['VN']}}));
+test('support cannot move an in-scope source outside scope',()=>assert.throws(()=>sourceHook({req:req('support'),data:{jurisdiction:'DE'},originalDoc:approvedSource}),/Country scope/));
+test('member cannot self-publish knowledge',()=>assert.throws(()=>sourceHook({req:req('member'),data:{jurisdiction:'VN',_status:'published'}}),/Country scope|Knowledge staff/));
+test('self-publication records the edited revision author',()=>{const d=sourceHook({req:req('support'),data:{body:'Revised answer',_status:'published'},originalDoc:approvedSource});assert.equal(d.approved,true);assert.equal(d.reviewedBy,1);assert.equal(d._status,'published')});
 test('reviewer cannot move source to another country',()=>assert.throws(()=>sourceHook({req:req('reviewer'),data:{jurisdiction:'DE'},originalDoc:approvedSource}),/Country scope/));
